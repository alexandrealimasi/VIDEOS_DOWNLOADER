{
  "manifest_version": 3,
  "name": "VideoGrabber Desktop Companion",
  "version": "1.0.0",
  "description": "Ajoute un bouton de téléchargement direct sur YouTube et sites compatibles pour VideoGrabber Desktop.",
  "icons": {
    "48": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.vimeo.com/*",
        "https://*.dailymotion.com/*",
        "https://*.tiktok.com/*",
        "https://*.soundcloud.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
